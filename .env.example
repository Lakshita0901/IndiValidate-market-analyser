# ==============================================================================
# IndiValidate / Market Analyzer Environment Variables
# ==============================================================================

# Mistral AI Configuration (Primary LLM for all text generation, persona simulation & analysis)
# Obtain an API key from https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Configurable Mistral Model ID
# Supported models: mistral-small-latest (recommended default), mistral-large-latest, open-mistral-nemo, codestral-latest
MISTRAL_MODEL=mistral-small-latest

# Google Gemini Configuration (Independent - used exclusively for embeddings if GoogleEmbeddingProvider is enabled)
# Note: Text generation runs independently via Mistral AI.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Census 2011 & PLFS 2025: Local official datasets in data/census/ and data/plfs/ (no API key required)
